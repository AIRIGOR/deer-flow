  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pdf-parse": "^1.1.5",
    "netlify-cli": "^27.10.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "netlify-cli": {
      "sharp": "0.35.5"
    }
  }
